{
	"name": "pi-show-provider-gentle-pi",
	"version": "1.0.0",
	"description": "Pi package with a /show-provider-gentle-pi on|off command to show provider/model instead of only model in the gentle-pi shell bar.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandregz/pi-show-provider-gentle-pi.git"
	},
	"files": [
		"extensions/",
		"README.md",
		"README.en.md",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi",
		"gentle-pi",
		"gentle-ai",
		"extension",
		"shell-bar",
		"provider"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"prepublishOnly": "npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
